# relayAI 环境变量与本地启动

# ---------------------------------------------------------------------------
# 数据库（Go 管理面 + Rust 网关共用）
# ---------------------------------------------------------------------------
# PostgreSQL 连接串。生产环境必须用强密码。
DATABASE_URL=postgresql://postgres:root@localhost:5432/relayai

# ---------------------------------------------------------------------------
# Rust 网关
# ---------------------------------------------------------------------------
# 凭据加密主密钥：32 字节的 base64。
#
# 生成方式（PowerShell）：
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#
# **丢失这把密钥 = 所有账号凭据作废**，必须重新登录。
# 参考项目把主密钥存在系统凭据库；服务端没有交互式凭据库，所以走环境变量。
RELAYAI_MASTER_KEY=

# Go 管理面 ↔ Rust 网关的共享密钥（`/internal/*` 鉴权）。
# 两端必须一致，否则管理面调不动网关。
GATEWAY_INTERNAL_TOKEN=

# 网关监听端口。被占用时会自动向后回退（18788 → 18789 → …）。
#
# 为什么不用 8788 / 8790：这两个端口在本机已被其他常驻服务占用，
# 用它们必然触发回退，导致 GATEWAY_BASE_URL 与实际监听端口不一致。
GATEWAY_PORT=18788

# 监听地址。默认只绑回环；改成 0.0.0.0 时必须先在管理面配好 API Key。
GATEWAY_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Go 管理面
# ---------------------------------------------------------------------------
# 网关地址。**必须与网关实际监听的端口一致**：
# 网关端口被占用时会回退，此时这里也要跟着改，否则管理面会打到别人身上。
GATEWAY_BASE_URL=http://127.0.0.1:18788
