syntax = "v1"

info (
	title:   "relayAI API"
	desc:    "relayAI 管理面 REST API（本文档为契约说明；路由由 internal/handler 手写注册）"
	author:  "relayAI"
	version: "v0.3.0"
)

// 说明：本文件描述 API 契约，**不再用于 goctl 生成**。
//
// 原因（SPEC 7）：
//   1. 管理面有大量 PATCH 部分更新（只传要改的字段），goctl 的 optional
//      语义无法区分"没传"与"传了零值"，会静默把字段清零；
//   2. 部分响应带 `interface{}`（如渠道 options、设置值），生成的结构体没有类型收益；
//   3. 需要统一的错误信封与分页封装，手写更直接。
//
// 路由注册见 internal/handler/routes.go，契约与本文保持一致。

type HealthRequest {}

type HealthData {
	Service  string `json:"service"`
	Status   string `json:"status"`
	Version  string `json:"version"`
	Database string `json:"database"` // up | down
	UptimeMs int64  `json:"uptimeMs"`
}

type HealthResponse {
	Code    int        `json:"code"`
	Success bool       `json:"success"`
	Msg     string     `json:"msg"`
	Data    HealthData `json:"data"`
}

// Models are queried through the gateway; credentials are not persisted by discovery.
type ModelDiscoveryRequest {
	BaseURL string `json:"baseUrl"`
	APIKey string `json:"apiKey"`
	Protocol string `json:"protocol"`
	AccountID int64 `json:"accountId,optional"` // Use the saved key when apiKey is empty.
}

type DiscoveredModel {
	ID string `json:"id"`
	DisplayName string `json:"display_name,optional"`
	ContextLength int64 `json:"context_length,optional"`
	MaxOutputTokens int64 `json:"max_output_tokens,optional"`
	Capabilities map[string]bool `json:"capabilities,optional"`
	ReasoningEfforts []string `json:"reasoning_efforts,optional"`
	ReasoningEffortMap map[string]string `json:"reasoning_effort_map,optional"`
	ReasoningDefaultEffort string `json:"reasoning_default_effort,optional"`
}

type ModelDiscoveryResponse {
	Code int `json:"code"`
	Success bool `json:"success"`
	Msg string `json:"msg,optional"`
	Data []DiscoveredModel `json:"data"`
}

type AccountModelsRequest {
	ID int64 `path:"id"`
}

type LiveAccountModel {
	ID string `json:"id"`
	DisplayName interface{} `json:"displayName"` // string | null
	ContextWindow interface{} `json:"contextWindow"` // integer | null
	MaxOutput interface{} `json:"maxOutput"` // integer | null
	Capabilities map[string]bool `json:"capabilities"`
	Credits interface{} `json:"credits"` // official text | null
	CreditMultiplier interface{} `json:"creditMultiplier"` // number | null
	ChargeType string `json:"chargeType"` // free | credits | unknown
}

type LiveAccountModels {
	Realm string `json:"realm"` // cn | intl
	FetchedAtMs int64 `json:"fetchedAtMs"`
	Models []LiveAccountModel `json:"models"`
}

type AccountModelsResponse {
	Code int `json:"code"`
	Success bool `json:"success"`
	Msg string `json:"msg,optional"`
	Data LiveAccountModels `json:"data"`
}

@server (
	prefix: /api/v1
)
service backend-api {
	@handler HealthHandler
	get /health (HealthRequest) returns (HealthResponse)

	@handler ModelDiscoveryHandler
	post /model-discoveries (ModelDiscoveryRequest) returns (ModelDiscoveryResponse)

	// Admin-only, account-scoped upstream query; Cache-Control: no-store.
	@handler AccountModelsHandler
	get /accounts/:id/models (AccountModelsRequest) returns (AccountModelsResponse)
}
